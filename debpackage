#!/usr/bin/env bash
set -e

# 1. Define variables for your project
APP_NAME="adventure"
VERSION="0.8"
MAIN_JAR="adventure.jar"
INPUT_DIR="build/libs" # The local folder containing your JARs

echo "🚀 Starting jpackage process inside Docker..."

# 2. Run the vanilla Eclipse Temurin image 
docker run --rm \
  -v "$(pwd)":/workspace \
  -w /workspace \
  eclipse-temurin:21-jdk \
  bash -c "
    export DEBIAN_FRONTEND=noninteractive 
    echo '📦 Installing native Debian packaging utilities...' && \
    apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends fakeroot dpkg-dev > /dev/null && \
    \
    echo '🔨 Running jpackage...' && \
    jpackage \
      --type deb \
      --name '$APP_NAME' \
      --app-version '$VERSION' \
      --input '$INPUT_DIR' \
      --main-jar '$MAIN_JAR' \
      --dest output
  "

echo "✅ Done! Your .deb package should be in the local 'output/' directory."
